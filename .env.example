# ------------------------------------------------------------
# Frontend (Vite — envDir: monorepo root via apps/frontend/vite.shared.ts, or per-app .env)
# ------------------------------------------------------------
# Django 5.x REST API base URL (required in production, e.g. http://localhost:8000).
VITE_API_BASE_URL=""
# Set to "true" ONLY when explicitly running without a backend in standalone demo mode.
VITE_ENABLE_DEMO_MODE="false"
# Cross-app links (corporate site; optional for local dev defaults)
VITE_STOREFRONT_URL="http://localhost:3000/"
VITE_B2B_URL="http://localhost:3001/b2b/giris"
VITE_OPS_URL="http://localhost:3002/ops/giris"
# Commercial modules (what this customer purchased). Defaults = all on for local monorepo.
# B2C storefront UI is optional; turn off when customer only buys B2B / API.
VITE_ENABLE_B2C_STOREFRONT="true"
VITE_ENABLE_B2B_PORTAL="true"
VITE_ENABLE_OPS_PORTAL="true"
# Optional: iyzico Checkout Form for B2C cards (pair with ENABLE_IYZICO_PAYMENTS)
VITE_ENABLE_IYZICO_PAYMENTS="true"
# Product sales channels available in PIM. Omit B2C_API if not purchased.
VITE_ENABLED_SALES_CHANNELS="B2B,B2B_API,B2C_API"
# External integrations: create keys in OPS → /ops/api-anahtarlari
# Header: Authorization: Bearer tg_live_…   or   X-Api-Key: tg_live_…

# ------------------------------------------------------------
# Backend (Django 5.x + PostgreSQL + Redis + Celery)
# ------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
# Dedicated HMAC pepper for API key hashes (recommended in production). Falls back to SECRET_KEY.
API_KEY_HASH_PEPPER=
# Set 0 ONLY for local HTTP development; MUST be 1 in HTTPS production.
DJANGO_SECURE_COOKIES=0
# When DJANGO_SECURE_COOKIES=1: HSTS / SSL redirect enabled (override if needed)
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SESSION_COOKIE_AGE=43200
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# DRF rate limits (login is also enforced on SessionLoginView)
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_LOGIN=10/min
DRF_THROTTLE_API_KEY=120/min
# Reverse proxy hop count for anon throttle client IP (e.g. 1 behind nginx). Leave empty locally.
# NUM_PROXIES=1

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=taragold
POSTGRES_USER=taragold
POSTGRES_PASSWORD=
# Required in production when DJANGO_DEBUG=0 (Docker Compose builds it automatically from POSTGRES_* above):
DATABASE_URL=postgresql://taragold:CHANGE_ME@db:5432/taragold

# Celery/kombu requires Redis 5+ (Redis 7 recommended). Windows Redis 3.x will not run workers.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Initial seed password for management command `seed_taragold`
SEED_ADMIN_PASSWORD=

# Purchased sales channels for this deployment (backend). Omit B2C_API if not sold.
# ENABLED_SALES_CHANNELS=B2B,B2B_API

# Account lifecycle / B2C self-registration
ENABLE_B2C_SELF_REGISTER=1
# When 1, login requires email_verified_at (after /api/v1/auth/email/verify)
ENFORCE_EMAIL_VERIFICATION=0
FRONTEND_STOREFRONT_URL=http://localhost:3000

# Optional commercial module: set 0 to omit apps.payments from INSTALLED_APPS / routes
ENABLE_IYZICO_PAYMENTS=1
# iyzico Checkout Form — sandbox by default; production = live keys + api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=sandbox-api.iyzipay.com
# Must be a public HTTPS origin that forwards to Django (use ngrok locally).
# Example: https://abc123.ngrok-free.app  → callback at /api/v1/payments/iyzico/callback
# Also add the ngrok host to DJANGO_ALLOWED_HOSTS (and CSRF_TRUSTED_ORIGINS if needed).
IYZICO_CALLBACK_BASE_URL=http://localhost:8000

DEFAULT_FROM_EMAIL=noreply@taragold.local
# Local default = console backend. Production: django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# AES-256 key for SmtpSetting passwords (apps.mail). Falls back to DJANGO_SECRET_KEY.
MAIL_ENCRYPTION_KEY=
# MAIL_DEFAULT_LOGO_URL=https://cdn.example.com/logo.png


# KVKK document retention: soft-deactivate expired docs daily.
# Hard-delete inactive files only when >0 (days after deactivation).
DOCUMENT_HARD_DELETE_DAYS=0

# Observability
LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Market rates Celery task
# MARKET_RATES_FEED_URL=https://rates.example.com/fx.json
# MARKET_RATES_REFRESH_CLONE=0

# Media persistence
# Docker Compose mounts named volume `media_data` → /app/media
# For S3/MinIO (optional; when set, django-storages is used instead of local disk):
# AWS_STORAGE_BUCKET_NAME=taragold-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=eu-central-1
# AWS_S3_ENDPOINT_URL=http://minio:9000
# AWS_QUERYSTRING_AUTH=1

# Backups (scripts/backup_postgres.sh | .ps1)
# BACKUP_DIR=
# BACKUP_RETENTION_DAYS=14

# ------------------------------------------------------------
# AI Studio Runtime (injected automatically in hosted preview)
# ------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
